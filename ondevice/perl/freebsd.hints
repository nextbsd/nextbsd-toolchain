# perl-cross hints for NextBSD (FreeBSD 15.1 ABI), installed by build-tools.sh
# as cnf/hints/freebsd in the perl-cross tree. perl-cross ships hints for Linux,
# NetBSD and a few others but none for FreeBSD; these are the values it can't
# probe by compiling and linking, taken from Perl's own hints/freebsd.sh and the
# config.sh of a native FreeBSD 15 perl.

# Libraries perl links: libm, libcrypt (crypt() is not in FreeBSD's libc) and
# libutil.
libswanted='m crypt util'

# Syscalls the probes can't see as working.
d_voidsig='define'
d_nanosleep='define'
d_clock_gettime='define'
d_clock_getres='define'
d_clock_nanosleep='define'
d_clock='define'
d_fcntl_can_lock='define'

# ino_t is an unsigned 64-bit type.
st_ino_sign=1
st_ino_size=8

# $^X comes from sysctl kern.proc.pathname, not /proc (which NextBSD doesn't
# mount).
usekernprocpathname='define'
d_procselfexe='undef'

usemallocwrap='define'
