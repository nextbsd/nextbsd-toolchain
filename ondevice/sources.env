# Pinned sources for the NextBSD-toolchain package (nextbsd-toolchain#16), the
# tools that run ON NextBSD. clang/lld are not pinned here: they build from the
# one LLVM pin in ../llvm/source.env (llvmorg-19.1.7), shared with the cross
# toolchain image and the static LLVM for Mesa.
#
# Every tarball is checked against its SHA-256 before it is unpacked. Bumping a
# component means moving its version, URL and SHA-256 together.

# GNU make, installed as gmake (GPLv3+).
GMAKE_VERSION=4.4.1
GMAKE_URL=https://ftp.gnu.org/gnu/make/make-4.4.1.tar.gz
GMAKE_SHA256=dd16fb1d67bfab79a72f5e8390735c49e3e8e70b4945a15ab1f81ddb78658fb3

# pkgconf (ISC), with pkg-config as a link to it. Never freedesktop's GPL
# pkg-config (E24 D1).
PKGCONF_VERSION=2.5.1
PKGCONF_URL=https://distfiles.ariadne.space/pkgconf/pkgconf-2.5.1.tar.xz
PKGCONF_SHA256=cd05c9589b9f86ecf044c10a2269822bc9eb001eced2582cfffd658b0a50c243

# Apple's Git (E24 D9): apple-oss-distributions/git tag Git-155, which carries
# upstream Git 2.50.1 unmodified in src/git, plus prebuilt man pages in
# src/git-manpages. Apple's Xcode Makefile is not used (build-tools.sh builds
# src/git with Git's own Makefile); its one patch (CVE-2021-21300) has been
# upstream since 2.30.2 and is not applied. GPLv2.
GIT_APPLE_TAG=Git-155
GIT_VERSION=2.50.1
GIT_URL=https://github.com/apple-oss-distributions/git/archive/refs/tags/Git-155.tar.gz
GIT_SHA256=1ee91aca95e75a74cb334aefde38dd87df06a6ab6b3cfb0aa42fda9aaba21b78

# --- The build tools Gershwin's on-machine build needs besides the compiler
# --- (nextbsd-toolchain#27, E24 D11: cmake and autotools as extras).

# GNU m4, installed as /usr/bin/gm4 (base's /usr/bin/m4 is BSD m4). Autoconf
# runs it. GPLv3+.
M4_VERSION=1.4.21
M4_URL=https://ftp.gnu.org/gnu/m4/m4-1.4.21.tar.xz
M4_SHA256=f25c6ab51548a73a75558742fb031e0625d6485fe5f9155949d6486a2408ab66

# A minimal Perl for autoconf and automake only, private to them under
# /usr/libexec/autotools (not on PATH, no /usr/bin/perl). Cross-built with
# perl-cross, which replaces Perl's Configure with one that only compiles and
# links its probes, so it works with a cross compiler. Perl: Artistic or GPLv1+;
# perl-cross: same terms as Perl.
PERL_VERSION=5.44.0
PERL_URL=https://www.cpan.org/src/5.0/perl-5.44.0.tar.xz
PERL_SHA256=505cf43912e9480495c344c70260452e32aa2a73c546a026b3f100053b23ce91
PERLCROSS_VERSION=1.6.5
PERLCROSS_URL=https://github.com/arsv/perl-cross/releases/download/1.6.5/perl-cross-1.6.5.tar.gz
PERLCROSS_SHA256=81130cd4b8c6d9eb2a1959f37d44391a46ad6a6794fc41fed5441f74e85e3dd0

# GNU Autoconf (GPLv3+ with the Autoconf exception for generated scripts).
AUTOCONF_VERSION=2.73
AUTOCONF_URL=https://ftp.gnu.org/gnu/autoconf/autoconf-2.73.tar.xz
AUTOCONF_SHA256=9fd672b1c8425fac2fa67fa0477b990987268b90ff36d5f016dae57be0d6b52e

# GNU Automake (GPLv2+; its runtime files carry permissive exceptions).
AUTOMAKE_VERSION=1.19
AUTOMAKE_API=1.19
AUTOMAKE_URL=https://ftp.gnu.org/gnu/automake/automake-1.19.tar.xz
AUTOMAKE_SHA256=e3e2c2e3abf37898138db5b6c1d1dc35c9160c5978be7947d2c741705251d445

# GNU Libtool: the libtool and libtoolize scripts and their aclocal macros.
# libltdl is not installed (nothing in Gershwin's build links it). GPLv2+ with
# the Libtool exception for the files it copies into packages.
LIBTOOL_VERSION=2.6.2
LIBTOOL_URL=https://ftp.gnu.org/gnu/libtool/libtool-2.6.2.tar.xz
LIBTOOL_SHA256=2ef1067c16c97db930fd740cc9bc3d3ba9a583804ae5ac42cc3e8719e49e191e

# CMake (BSD-3-Clause; its bundled libraries are listed in NOTICE.md).
CMAKE_VERSION=4.4.4
CMAKE_URL=https://github.com/Kitware/CMake/releases/download/v4.4.4/cmake-4.4.4.tar.gz
CMAKE_SHA256=bd24c30d80a7744ae84b845ff080cc8453b06c622ef01066564108e9cefc44cf
