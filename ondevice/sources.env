# Pinned sources for the NextBSD-toolchain package (nextbsd-toolchain#16), the
# tools that run ON NextBSD. clang/lld are not pinned here: they build from the
# one LLVM pin in ../llvm/source.env (llvmorg-19.1.7), shared with the cross
# toolchain image and the static LLVM for Mesa.
#
# Every tarball is checked against its SHA-256 before it is unpacked. Bumping a
# component means moving its version, URL and SHA-256 together.

# GNU make, installed as gmake (GPLv3+).
GMAKE_VERSION=4.4.1
GMAKE_URL=https://ftp.gnu.org/gnu/make/make-4.4.1.tar.gz
GMAKE_SHA256=dd16fb1d67bfab79a72f5e8390735c49e3e8e70b4945a15ab1f81ddb78658fb3

# pkgconf (ISC), with pkg-config as a link to it. Never freedesktop's GPL
# pkg-config (E24 D1).
PKGCONF_VERSION=2.5.1
PKGCONF_URL=https://distfiles.ariadne.space/pkgconf/pkgconf-2.5.1.tar.xz
PKGCONF_SHA256=cd05c9589b9f86ecf044c10a2269822bc9eb001eced2582cfffd658b0a50c243

# Apple's Git (E24 D9): apple-oss-distributions/git tag Git-155, which carries
# upstream Git 2.50.1 unmodified in src/git, plus prebuilt man pages in
# src/git-manpages. Apple's Xcode Makefile is not used (build-tools.sh builds
# src/git with Git's own Makefile); its one patch (CVE-2021-21300) has been
# upstream since 2.30.2 and is not applied. GPLv2.
GIT_APPLE_TAG=Git-155
GIT_VERSION=2.50.1
GIT_URL=https://github.com/apple-oss-distributions/git/archive/refs/tags/Git-155.tar.gz
GIT_SHA256=1ee91aca95e75a74cb334aefde38dd87df06a6ab6b3cfb0aa42fda9aaba21b78
