FROM ubuntu:24.04

ARG TARGET=amd64
ARG TARGET_ARCH=amd64
ARG FREEBSD_BRANCH=releng/15.1
# Exact upstream commit to bake. Empty => use the branch tip (bootstrap/manual).
ARG FREEBSD_SHA=

# MAKEOBJDIRPREFIX must be in the ENV (the build refuses it as a make arg).
# CROSS_BINDIR points make.py at an EXTERNAL Clang 19 cross toolchain so it does
# NOT bootstrap its own LLVM (make.py requires an external toolchain on Linux).
# FreeBSD 15.1's own compiler is Clang 19, so stock clang-19 builds every module
# (e.g. iwlwifi, which needs the Clang 19 builtin __builtin_popcountg). Both
# vars are inherited by the downstream kernel/module jobs in this image.
ENV MAKEOBJDIRPREFIX=/usr/obj
ENV CROSS_BINDIR=/usr/lib/llvm-19/bin

# Host build deps a minimal ubuntu base lacks (the GitHub runner ships them):
# build-essential (host gcc/cc to bootstrap), bc/flex/bison (bmake tests,
# kbdcontrol), time (host-symlinks), libssl-dev (certctl), libarchive-dev,
# bmake, git/python3 (make.py), gh/curl (dispatch). Clang 19 / lld 19 come from
# apt.llvm.org (Ubuntu 24.04 ships only clang-18) and are the cross toolchain.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg \
    && curl -fsSL https://apt.llvm.org/llvm-snapshot.gpg.key \
        | gpg --dearmor -o /usr/share/keyrings/llvm.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/llvm.gpg] http://apt.llvm.org/noble/ llvm-toolchain-noble-19 main" \
        > /etc/apt/sources.list.d/llvm.list \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        | tee /usr/share/keyrings/githubcli-archive-keyring.gpg > /dev/null \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        build-essential bc time flex bison bmake ccache \
        libarchive-dev libssl-dev clang-19 lld-19 git python3 gh \
    && rm -rf /var/lib/apt/lists/*

# ccache cross wrapper: mirror the llvm-19 bindir but route clang/clang++ through
# ccache (FreeBSD's WITH_CCACHE_BUILD does NOT wrap an external XCC). Downstream
# kernel/world/module builds set --cross-bindir=$CCACHE_CROSS_BINDIR with a
# persisted CCACHE_DIR to cache compiles. The image's OWN kernel-toolchain build
# below keeps the real CROSS_BINDIR (no ccache needed there; it's layer-cached).
RUN mkdir -p /opt/ccache-cross \
    && for f in /usr/lib/llvm-19/bin/*; do \
         b="$(basename "$f")"; \
         case "$b" in clang|clang++) ;; *) ln -s "$f" "/opt/ccache-cross/$b" ;; esac; \
       done \
    && printf '#!/bin/sh\nexec /usr/bin/ccache /usr/lib/llvm-19/bin/clang "$@"\n' > /opt/ccache-cross/clang \
    && printf '#!/bin/sh\nexec /usr/bin/ccache /usr/lib/llvm-19/bin/clang++ "$@"\n' > /opt/ccache-cross/clang++ \
    && chmod +x /opt/ccache-cross/clang /opt/ccache-cross/clang++
ENV CCACHE_CROSS_BINDIR=/opt/ccache-cross

# ---------------------------------------------------------------------------
# E23/E24 host build tools (nextbsd-toolchain#13). Build-time only, never
# shipped: the X stack, Mesa and the GNUstep/Gershwin support repos cross-build
# with meson, CMake and autotools from inside this image.
#   - ninja, cmake, autoconf/automake/libtool, Mesa's python mako + yaml: the
#     Ubuntu 24.04 packages (fixed per Ubuntu release).
#   - pkgconf: the ISC pkgconf (E24 D1), never freedesktop's GPL pkg-config.
#     Its /usr/bin/pkg-config name must belong to the pkgconf packages; the
#     build fails if anything else provides it.
#   - meson: pinned upstream release. Ubuntu's 1.3.2 is below Mesa 26.2.5's
#     `meson_version >= 1.4.0` (XLibre 25.2.2 needs >= 0.61.0). Run from the
#     verified source tarball; no pip.
#   - util-macros: pinned upstream X.Org tarball (provides xorg-macros.m4 for
#     autoreconf), installed under /usr so the stock aclocal finds it.
# ---------------------------------------------------------------------------
ARG MESON_VERSION=1.12.1
ARG MESON_SHA256=ab0a6ca09f8ef70c564c8241fb5a23957886a0b53fb58412b5e07eaf07dba743
ARG UTIL_MACROS_VERSION=1.20.2
ARG UTIL_MACROS_SHA256=9ac269eba24f672d7d7b3574e4be5f333d13f04a7712303b1821b2a51ac82e8e
RUN apt-get update && apt-get install -y --no-install-recommends \
        ninja-build cmake pkgconf autoconf automake libtool \
        python3-mako python3-yaml xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && case "$(dpkg -S "$(readlink -f /usr/bin/pkg-config)" /usr/bin/pkg-config)" in \
         *pkg-config:*) echo "freedesktop pkg-config installed; pkgconf only" >&2; exit 1 ;; \
       esac \
    && cd /tmp \
    && curl -fsSLo meson.tar.gz \
        "https://github.com/mesonbuild/meson/releases/download/${MESON_VERSION}/meson-${MESON_VERSION}.tar.gz" \
    && echo "${MESON_SHA256}  meson.tar.gz" | sha256sum -c - \
    && mkdir -p /opt/meson \
    && tar -xzf meson.tar.gz -C /opt/meson --strip-components=1 \
    && printf '#!/bin/sh\nexec /usr/bin/python3 /opt/meson/meson.py "$@"\n' > /usr/local/bin/meson \
    && chmod +x /usr/local/bin/meson \
    && curl -fsSLo util-macros.tar.xz \
        "https://xorg.freedesktop.org/releases/individual/util/util-macros-${UTIL_MACROS_VERSION}.tar.xz" \
    && echo "${UTIL_MACROS_SHA256}  util-macros.tar.xz" | sha256sum -c - \
    && tar -xJf util-macros.tar.xz \
    && cd "util-macros-${UTIL_MACROS_VERSION}" \
    && ./configure --prefix=/usr \
    && make install \
    && cd /tmp && rm -rf meson.tar.gz util-macros.tar.xz "util-macros-${UTIL_MACROS_VERSION}" \
    && test "$(meson --version)" = "${MESON_VERSION}" \
    && ninja --version && cmake --version && pkgconf --version && pkg-config --version \
    && autoconf --version && automake --version && libtoolize --version \
    && test -f /usr/share/aclocal/xorg-macros.m4 \
    && python3 -c 'import mako, yaml'

# Shallow (--depth 1) but FULL-TREE clone from the NextBSD fork.
# Deliberately NOT sparse: kernel-toolchain/buildkernel need share/mk,
# tools/build, usr.bin/, gnu/, lib/ ... a sys-only tree fails the build.
# Shallow (no git history) is fine; sparse is what breaks it.
# FREEBSD_SHA pins the baked source to the change-detected commit.
RUN git clone --depth 1 --branch "${FREEBSD_BRANCH}" \
        https://github.com/nextbsd/freebsd-src.git /usr/src \
    && if [ -n "${FREEBSD_SHA}" ]; then \
         cd /usr/src \
         && git fetch --depth 1 origin "${FREEBSD_SHA}" \
         && git checkout -q "${FREEBSD_SHA}"; \
       fi

# Build ONLY the kernel toolchain, using the external Clang 19 via --cross-bindir
# so make.py doesn't bootstrap its own LLVM (fast + lean). Downstream kernel and
# module jobs run inside this image and reuse this staged build env + clang-19.
RUN mkdir -p "${MAKEOBJDIRPREFIX}" \
    && cd /usr/src && ./tools/build/make.py \
        --cross-bindir="${CROSS_BINDIR}" \
        TARGET="${TARGET}" TARGET_ARCH="${TARGET_ARCH}" \
        kernel-toolchain -j"$(nproc)"
