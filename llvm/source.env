# Pinned upstream LLVM source for the NextBSD toolchain image.
#
# llvmorg-19.1.7 is the exact revision FreeBSD releng/15.1 imported into
# contrib/llvm-project (VCSRevision.h: llvmorg-19.1.7-0-gcd708029e0b2), so the
# cross compiler matches the base system's own compiler. Bumping this is a
# deliberate change: version, revision, URL and SHA-256 move together, and the
# tiny static LLVM for Mesa (nextbsd-toolchain#12) builds from the same pin.
LLVM_VERSION=19.1.7
LLVM_MAJOR=19
LLVM_TAG=llvmorg-19.1.7
LLVM_REVISION=cd708029e0b2869e80abe31ddb175f7c35361f90
LLVM_URL=https://github.com/llvm/llvm-project/releases/download/llvmorg-19.1.7/llvm-project-19.1.7.src.tar.xz
LLVM_SHA256=82401fea7b79d0078043f7598b835284d6650a75b93e64b6f761ea7b63097501
