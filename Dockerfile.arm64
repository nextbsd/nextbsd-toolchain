# ---------------------------------------------------------------------------
# Stage "llvm": clang/lld 19.1.7 built from pinned upstream source (CMake).
#
# This stage is IDENTICAL in Dockerfile.amd64 and Dockerfile.arm64 (the
# compiler runs on the x86_64 host and cross-compiles to both targets), so both
# legs share one cached result. The workflow builds it once in its own job and
# keeps it in the GitHub Actions cache; it is rebuilt only when this stage or
# llvm/ (the pin in llvm/source.env, the build recipe) changes. The base is
# pinned by digest for the same reason: a refreshed ubuntu:24.04 tag would
# otherwise force a full LLVM rebuild.
# ---------------------------------------------------------------------------
FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac AS llvm

# Host build tools for LLVM only; none of them reach the final image.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl xz-utils build-essential binutils cmake \
        ninja-build python3 zlib1g-dev libzstd-dev \
    && rm -rf /var/lib/apt/lists/*

COPY llvm/ /usr/src/nextbsd-llvm/
RUN /usr/src/nextbsd-llvm/build-llvm.sh /usr/lib/llvm-19

# ---------------------------------------------------------------------------
# Stages "mesa-clc-llvm" and "mesa-clc": host libraries for Mesa's mesa_clc
# (nextbsd-toolchain#11, E23 plan step 1, D7). Build-host only, never shipped.
#
# iris and crocus compile Intel's internal OpenCL C shaders to SPIR-V at build
# time with mesa_clc, a program that runs on the x86_64 build host and links
# clang, LLVM, SPIRV-LLVM-Translator and SPIRV-Tools. These stages build them
# for the host, into /opt/mesa-clc: LLVM/clang 19.1.7 as shared libraries (the
# same llvm/source.env pin as the cross clang above), SPIRV-LLVM-Translator
# v19.1.x and SPIRV-Tools + SPIRV-Headers (mesa-clc/sources.env). See
# mesa-clc/README.md.
#
# Like "llvm", both stages are IDENTICAL in Dockerfile.amd64 and
# Dockerfile.arm64 and are kept in the GitHub Actions cache by their own job.
# They are separate from "llvm", so they never change its cache key; LLVM is
# its own stage so a SPIR-V-only change does not rebuild it.
# ---------------------------------------------------------------------------
FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac AS mesa-clc-llvm

# Same host build tools (and layer) as the "llvm" stage; none reach the image.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl xz-utils build-essential binutils cmake \
        ninja-build python3 zlib1g-dev libzstd-dev \
    && rm -rf /var/lib/apt/lists/*

COPY llvm/source.env llvm/fetch-llvm.sh /usr/src/nextbsd/llvm/
COPY mesa-clc/build-llvm.sh /usr/src/nextbsd/mesa-clc/
RUN /usr/src/nextbsd/mesa-clc/build-llvm.sh /opt/mesa-clc

FROM mesa-clc-llvm AS mesa-clc
COPY mesa-clc/ /usr/src/nextbsd/mesa-clc/
RUN /usr/src/nextbsd/mesa-clc/build-spirv.sh /opt/mesa-clc

# ---------------------------------------------------------------------------
# Final image. Always rebuilt from scratch (the workflow disables the cache for
# this stage), so the baked /usr/src always matches FREEBSD_SHA.
# ---------------------------------------------------------------------------
FROM ubuntu:24.04 AS toolchain

ARG TARGET=arm64
ARG TARGET_ARCH=aarch64
ARG FREEBSD_BRANCH=releng/15.1
# Exact upstream commit to bake. Empty => use the branch tip (bootstrap/manual).
ARG FREEBSD_SHA=

# MAKEOBJDIRPREFIX must be in the ENV (the build refuses it as a make arg).
# CROSS_BINDIR points make.py at an EXTERNAL Clang 19 cross toolchain so it does
# NOT bootstrap its own LLVM (make.py requires an external toolchain on Linux).
# That toolchain is the source-built llvmorg-19.1.7 from the "llvm" stage, the
# same revision as FreeBSD 15.1's own compiler, so it builds every module
# (e.g. iwlwifi, which needs the Clang 19 builtin __builtin_popcountg). clang
# cross-compiles, so the host LLVM bindir is the same for the aarch64 target.
ENV MAKEOBJDIRPREFIX=/usr/obj
ENV CROSS_BINDIR=/usr/lib/llvm-19/bin

# Host build deps a minimal ubuntu base lacks (the GitHub runner ships them):
# build-essential (host gcc/cc to bootstrap), bc/flex/bison (bmake tests,
# kbdcontrol), time (host-symlinks), libssl-dev (certctl), libarchive-dev,
# bmake, git/python3 (make.py), gh/curl (dispatch). The cross toolchain is NOT
# from apt: it is copied in from the "llvm" stage (COPY --from=llvm, next).
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        | tee /usr/share/keyrings/githubcli-archive-keyring.gpg > /dev/null \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        build-essential bc time flex bison bmake ccache \
        libarchive-dev libssl-dev git python3 gh \
    && rm -rf /var/lib/apt/lists/*

# clang/lld/llvm binutils 19.1.7 at the path the apt packages used, so
# CROSS_BINDIR and every downstream tool path stay the same.
COPY --from=llvm /usr/lib/llvm-19 /usr/lib/llvm-19

# Compatibility with the former apt.llvm.org layout, so nothing downstream has
# to change:
# - /usr/bin/<tool>-19 names (clang-19, ld.lld-19, llvm-ar-19, ...).
RUN for f in /usr/lib/llvm-19/bin/*; do \
         b="$(basename "$f")"; \
         case "$b" in *-19) n="$b" ;; *) n="$b-19" ;; esac; \
         ln -s "$f" "/usr/bin/$n"; \
       done \
    && /usr/lib/llvm-19/bin/clang --version

# ccache cross wrapper: mirror the llvm-19 bindir but route clang/clang++ through
# ccache (FreeBSD's WITH_CCACHE_BUILD does NOT wrap an external XCC). Downstream
# kernel/world/module builds set --cross-bindir=$CCACHE_CROSS_BINDIR with a
# persisted CCACHE_DIR to cache compiles. The image's OWN kernel-toolchain build
# below keeps the real CROSS_BINDIR (no ccache needed there; it's layer-cached).
RUN mkdir -p /opt/ccache-cross \
    && for f in /usr/lib/llvm-19/bin/*; do \
         b="$(basename "$f")"; \
         case "$b" in clang|clang++) ;; *) ln -s "$f" "/opt/ccache-cross/$b" ;; esac; \
       done \
    && printf '#!/bin/sh\nexec /usr/bin/ccache /usr/lib/llvm-19/bin/clang "$@"\n' > /opt/ccache-cross/clang \
    && printf '#!/bin/sh\nexec /usr/bin/ccache /usr/lib/llvm-19/bin/clang++ "$@"\n' > /opt/ccache-cross/clang++ \
    && chmod +x /opt/ccache-cross/clang /opt/ccache-cross/clang++
ENV CCACHE_CROSS_BINDIR=/opt/ccache-cross

# ---------------------------------------------------------------------------
# E23/E24 host build tools (nextbsd-toolchain#13). Build-time only, never
# shipped: the X stack, Mesa and the GNUstep/Gershwin support repos cross-build
# with meson, CMake and autotools from inside this image.
#   - ninja, cmake, autoconf/automake/libtool, Mesa's python mako + yaml: the
#     Ubuntu 24.04 packages (fixed per Ubuntu release). Mesa's meson also
#     needs python's packaging (Ubuntu's Python 3.12 has no distutils).
#   - pkgconf: the ISC pkgconf (E24 D1), never freedesktop's GPL pkg-config.
#     Its /usr/bin/pkg-config name must belong to the pkgconf packages; the
#     build fails if anything else provides it.
#   - meson: pinned upstream release. Ubuntu's 1.3.2 is below Mesa 26.2.5's
#     `meson_version >= 1.4.0` (XLibre 25.2.2 needs >= 0.61.0). Run from the
#     verified source tarball; no pip.
#   - util-macros: pinned upstream X.Org tarball (provides xorg-macros.m4 for
#     autoreconf), installed under /usr so the stock aclocal finds it.
# ---------------------------------------------------------------------------
ARG MESON_VERSION=1.12.1
ARG MESON_SHA256=ab0a6ca09f8ef70c564c8241fb5a23957886a0b53fb58412b5e07eaf07dba743
ARG UTIL_MACROS_VERSION=1.20.2
ARG UTIL_MACROS_SHA256=9ac269eba24f672d7d7b3574e4be5f333d13f04a7712303b1821b2a51ac82e8e
RUN apt-get update && apt-get install -y --no-install-recommends \
        ninja-build cmake pkgconf autoconf automake libtool \
        python3-mako python3-packaging python3-yaml xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && case "$(dpkg -S "$(readlink -f /usr/bin/pkg-config)" /usr/bin/pkg-config)" in \
         *pkg-config:*) echo "freedesktop pkg-config installed; pkgconf only" >&2; exit 1 ;; \
       esac \
    && cd /tmp \
    && curl -fsSLo meson.tar.gz \
        "https://github.com/mesonbuild/meson/releases/download/${MESON_VERSION}/meson-${MESON_VERSION}.tar.gz" \
    && echo "${MESON_SHA256}  meson.tar.gz" | sha256sum -c - \
    && mkdir -p /opt/meson \
    && tar -xzf meson.tar.gz -C /opt/meson --strip-components=1 \
    && printf '#!/bin/sh\nexec /usr/bin/python3 /opt/meson/meson.py "$@"\n' > /usr/local/bin/meson \
    && chmod +x /usr/local/bin/meson \
    && curl -fsSLo util-macros.tar.xz \
        "https://xorg.freedesktop.org/releases/individual/util/util-macros-${UTIL_MACROS_VERSION}.tar.xz" \
    && echo "${UTIL_MACROS_SHA256}  util-macros.tar.xz" | sha256sum -c - \
    && tar -xJf util-macros.tar.xz \
    && cd "util-macros-${UTIL_MACROS_VERSION}" \
    && ./configure --prefix=/usr \
    && make install \
    && cd /tmp && rm -rf meson.tar.gz util-macros.tar.xz "util-macros-${UTIL_MACROS_VERSION}" \
    && test "$(meson --version)" = "${MESON_VERSION}" \
    && ninja --version && cmake --version && pkgconf --version && pkg-config --version \
    && autoconf --version && automake --version && libtoolize --version \
    && test -f /usr/share/aclocal/xorg-macros.m4 \
    && python3 -c 'import mako, packaging, yaml'

# ---------------------------------------------------------------------------
# E24 host build tools built from pinned upstream source (nextbsd-toolchain#23,
# #25). Build-time only, never shipped. Built with the host cc into /usr/local.
#   - NASM: libjpeg-turbo's x86-64 SIMD and FFmpeg's x86-64 assembly in
#     nextbsd-gnustep-support. Upstream nasm.us release tarball.
#   - gperf: fontconfig's object hash in nextbsd-xlibs. gperf is GPL-3.0: it
#     runs only on the build host and is never shipped in NextBSD. Upstream
#     ftp.gnu.org tarball.
# ---------------------------------------------------------------------------
ARG NASM_VERSION=3.02
ARG NASM_SHA256=87336eba53b4acfe917424ab5d500d2b0054d9f5148d35c2273ccf2cfb712f0d
ARG GPERF_VERSION=3.3
ARG GPERF_SHA256=fd87e0aba7e43ae054837afd6cd4db03a3f2693deb3619085e6ed9d8d9604ad8
RUN cd /tmp \
    && curl -fsSLo nasm.tar.xz \
        "https://www.nasm.us/pub/nasm/releasebuilds/${NASM_VERSION}/nasm-${NASM_VERSION}.tar.xz" \
    && echo "${NASM_SHA256}  nasm.tar.xz" | sha256sum -c - \
    && tar -xJf nasm.tar.xz \
    && cd "nasm-${NASM_VERSION}" \
    && ./configure --prefix=/usr/local \
    && make -j"$(nproc)" nasm ndisasm \
    && install -m 0755 nasm ndisasm /usr/local/bin/ \
    && cd /tmp \
    && curl -fsSLo gperf.tar.gz \
        "https://ftp.gnu.org/gnu/gperf/gperf-${GPERF_VERSION}.tar.gz" \
    && echo "${GPERF_SHA256}  gperf.tar.gz" | sha256sum -c - \
    && tar -xzf gperf.tar.gz \
    && cd "gperf-${GPERF_VERSION}" \
    && ./configure --prefix=/usr/local \
    && make -j"$(nproc)" \
    && make install \
    && cd /tmp && rm -rf nasm.tar.xz "nasm-${NASM_VERSION}" gperf.tar.gz "gperf-${GPERF_VERSION}" \
    && nasm -v | grep -q "^NASM version ${NASM_VERSION} " \
    && test "$(gperf --version | head -1)" = "GNU gperf ${GPERF_VERSION}" \
    && nasm -v && gperf --version | head -1

# ---------------------------------------------------------------------------
# E23 host libraries for Mesa's mesa_clc (nextbsd-toolchain#11), from the
# "mesa-clc" stage. Build-time only, never shipped: nextbsd-mesa builds
# mesa_clc and vtn_bindgen2 natively against /opt/mesa-clc (llvm-config,
# libLLVM/libclang-cpp 19.1.7, LLVMSPIRVLib 19.1.x, SPIRV-Tools; see
# mesa-clc/README.md), then cross-builds iris/crocus with -Dmesa-clc=system.
# The loader path entry lets the installed mesa_clc find libLLVM and
# libclang-cpp without an rpath.
# ---------------------------------------------------------------------------
COPY --from=mesa-clc /opt/mesa-clc /opt/mesa-clc
RUN echo /opt/mesa-clc/lib > /etc/ld.so.conf.d/mesa-clc.conf \
    && ldconfig \
    && test "$(/opt/mesa-clc/bin/llvm-config --version)" = 19.1.7 \
    && test "$(/opt/mesa-clc/bin/llvm-config --shared-mode)" = shared \
    && PKG_CONFIG_PATH=/opt/mesa-clc/lib/pkgconfig pkgconf --modversion LLVMSPIRVLib SPIRV-Tools \
    && PKG_CONFIG_PATH=/opt/mesa-clc/lib/pkgconfig pkgconf --atleast-version=19.1 --max-version=19.1.99 LLVMSPIRVLib \
    && PKG_CONFIG_PATH=/opt/mesa-clc/lib/pkgconfig pkgconf --atleast-version=2024.1 SPIRV-Tools \
    && cat /opt/mesa-clc/BUILD-INFO

# Shallow (--depth 1) but FULL-TREE clone from the NextBSD fork.
# Deliberately NOT sparse: kernel-toolchain/buildkernel need share/mk,
# tools/build, usr.bin/, gnu/, lib/ ... a sys-only tree fails the build.
# Shallow (no git history) is fine; sparse is what breaks it.
# FREEBSD_SHA pins the baked source to the change-detected commit.
RUN git clone --depth 1 --branch "${FREEBSD_BRANCH}" \
        https://github.com/nextbsd/freebsd-src.git /usr/src \
    && if [ -n "${FREEBSD_SHA}" ]; then \
         cd /usr/src \
         && git fetch --depth 1 origin "${FREEBSD_SHA}" \
         && git checkout -q "${FREEBSD_SHA}"; \
       fi

# Build ONLY the kernel toolchain, using the external Clang 19 via --cross-bindir
# so make.py doesn't bootstrap its own LLVM (fast + lean). Downstream kernel and
# module jobs run inside this image and reuse this staged build env + clang-19.
RUN mkdir -p "${MAKEOBJDIRPREFIX}" \
    && cd /usr/src && ./tools/build/make.py \
        --cross-bindir="${CROSS_BINDIR}" \
        TARGET="${TARGET}" TARGET_ARCH="${TARGET_ARCH}" \
        kernel-toolchain -j"$(nproc)"
